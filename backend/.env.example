PORT=5000

DATABASE_URL=

HF_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Set in production to restrict CORS to your deployed frontend origin.
# Leave unset in development for permissive CORS.
FRONTEND_URL=

# Optional: when both are set, uploaded PDFs are stored in Supabase Storage
# (bucket "documents") instead of the local uploads/ folder. Local disk is
# not reliable in production - most hosts wipe it on redeploy/restart.
# Leave both unset to keep using local disk (fine for development).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
